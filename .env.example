# Copy this file to .env and fill in your own values.
# Never commit the real .env file - it is already in .gitignore.

# Port the server runs on
PORT=5000

# MongoDB connection string (required)
DB_URI=your_mongodb_connection_string

# Frontend URL allowed by CORS (required)
CLIENT_URL=http://localhost:3000

# Better Auth server origin for JWT verification. Defaults to CLIENT_URL.
# Set this separately only when Better Auth is hosted on another origin.
# BETTER_AUTH_URL=http://localhost:3000

# Stripe test secret key (required for Pro upgrades)
STRIPE_SECRET_KEY=sk_test_your_key_here

# Stripe webhook signing secret (required - the webhook rejects any
# delivery whose stripe-signature does not match this value).
# Dashboard -> Developers -> Webhooks -> your endpoint -> Signing secret.
# Local dev (Stripe CLI): stripe listen --forward-to localhost:5000/api/payments/webhook
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here
